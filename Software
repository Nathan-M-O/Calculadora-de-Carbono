def calculadora_de_carbono(): 

    gasolina = float(input("Informe o consumo de gasolina (litros/mês): ")) 
    diesel = float(input("Informe o consumo de diesel (litros/mês): ")) 
    etanol = float(input("Informe o consumo de etanol (litros/mês): ")) 
    gnv = float(input("Informe o consumo de gás natural veicular (m³/mês): ")) 
    eletricidade = float(input("Informe o consumo de eletricidade (kWh/mês): ")) 
    gas = float(input("Informe o consumo de gás de cozinha (botijão 15kg/mês): ")) 
    carne_bovina = float(input("Informe o consumo de carne bovina (kg/mês): ")) 
    carne_frango = float(input("Informe o consumo de carne de frango (kg/mês): ")) 
    leite = float(input("Informe o consumo de leite (litros/mês): ")) 
    ovos = float(input("Informe o consumo de ovos (unidades/mês): ")) 
    aviao_br = int(input("Viagens nacionais de avião (número de viagens/ano): ")) 
    aviao_inter = int(input("Viagens internacionais de avião (número de viagens/ano): ")) 

    emissoes = { 
        "Gasolina": 0.0023, 
        "Diesel": 0.0027, 
        "Etanol": 0.0019, 
        "GNV": 0.0019, 
        "Eletricidade": 0.0003, 
        "Gás": 0.012, 
        "Carne Bovina": 0.0004, 
        "Carne Frango": 0.00003, 
        "Leite": 0.00005, 
        "Ovos": 0.00001, 
        "Voo BR": 0.05, 
        "Voo Internacional": 0.3 
    } 

    total_gasolina = gasolina * emissoes["Gasolina"] 
    total_diesel = diesel * emissoes["Diesel"] 
    total_etanol = etanol * emissoes["Etanol"] 
    total_gnv = gnv * emissoes["GNV"] 
    total_eletricidade = eletricidade * emissoes["Eletricidade"] 
    total_gas = gas * emissoes["Gás"] 
    total_carne_bovina = carne_bovina * emissoes["Carne Bovina"] 
    total_carne_frango = carne_frango * emissoes["Carne Frango"] 
    total_leite = leite * emissoes["Leite"] 
    total_ovos = ovos * emissoes["Ovos"] 
    total_voos_nacionais = (aviao_br * emissoes["Voo BR"]) / 12 
    total_voos_internacionais = (aviao_inter * emissoes["Voo Internacional"]) / 12 

    emissoes_totais_mensais = (total_gasolina + total_diesel + total_etanol + total_gnv + total_eletricidade + total_gas + total_carne_bovina + total_carne_frango + total_leite + total_ovos + total_voos_nacionais + total_voos_internacionais) 
    emissoes_totais_anuais = emissoes_totais_mensais * 12 
    cc = emissoes_totais_anuais 

       moeda = { 
        "R$": 26, 
        "USD$": 10, 
        "EUR$": 50 
    } 
  
    real = moeda["R$"] * cc 
    dolar = moeda["USD$"] * cc 
    euro = moeda["EUR$"] * cc 

print(f"Quantidade aproximada de emissões mensais: {emissoes_totais_mensais:.2f} toneladas de CO2") 
print(f"Quantidade aproximada de emissões anuais: {emissoes_totais_anuais:.2f} toneladas de CO2") 
print(f"Quantidade de créditos de carbono necessários para compensar as emissões: {cc:.2f}") 
print(f"Preço dos créditos de carbono necessários em real: {real:.2f}") 
print(f"Preço dos créditos de carbono necessários em dólar: {dolar:.2f}") 
print(f"Preço dos créditos de carbono necessários em euro: {euro:.2f}") 
